          "reply_markup": "{\"inline_keyboard\":[[{\"text\":\"💬 پشتیبانی تلگرام\",\"url\":\"https://t.me/ravi_support\"}],[{\"text\":\"🏠 منوی اصلی\",\"callback_data\":\"menu\"}]]}"
        },
        "options": {}
      }
    },

