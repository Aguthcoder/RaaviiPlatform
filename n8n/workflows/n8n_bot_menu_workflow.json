          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-build-myevents",
      "name": "Build: My Events Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 860],
      "parameters": {
        "jsCode": "const events = $input.first().json.events || [];\nconst chatId = $('Extract: Chat Info').first().json.chatId;\n\nif (events.length === 0) {\n  return [{ json: { chat_id: chatId, text: '📅 هنوز در هیچ رویدادی ثبت‌نام نکردی!', reply_markup: JSON.stringify({ inline_keyboard: [[{ text: '🏠 منو', callback_data: 'menu' }]] }) } }];\n}\n\nlet text = '📅 رویدادهای من:\\n\\n';\nevents.slice(0,5).forEach((ev, i) => {\n  const st = ev.status === 'confirmed' ? '✅' : ev.status === 'cancelled' ? '❌' : '⏳';\n  const d = new Date(ev.date).toLocaleDateString('fa-IR', { weekday: 'short', month: 'short', day: 'numeric' });\n  text += `${i+1}. ${st} ${ev.title}\\n   📅 ${d}\\n\\n`;\n});\n\nreturn [{ json: { chat_id: chatId, text, reply_markup: JSON.stringify({ inline_keyboard: [[{ text: '🏠 منو', callback_data: 'menu' }]] }) } }];"
      }
    },
    {
      "id": "node-send-myevents",
      "name": "Send: My Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1520, 860],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $vars.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "chat_id": "={{ $json.chat_id }}",
          "text": "={{ $json.text }}",
          "reply_markup": "={{ $json.reply_markup }}"
        },
        "options": {}
      }
    },

