# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ravi_db

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
BCRYPT_ROUNDS=12
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CSRF Protection (Optional - set to true to enable)
ENABLE_CSRF=false
CSRF_SECRET=your-csrf-secret-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Email Configuration (if using email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@example.com

# OTP Configuration (if using OTP)
# OTP_EXPIRES_IN=300
# OTP_LENGTH=6
